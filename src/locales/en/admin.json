  "guide": {
    "pageTitle": "How to Use This Panel",
    "pageSubtitle": "A simple, step-by-step explanation of where to edit everything on your website. No technical knowledge needed.",
    "goToPage": "Go to this page",
    "topics": {
      "pricing": {
        "title": "How do I change prices?",
        "steps": [
          "From the sidebar, open \"Prices & Packages\".",
          "Press \"Edit\" next to the package you want to change.",
          "Update the price field, then press \"Save Plan\".",
          "The new price appears on the website immediately."
        ]
      },
      "services": {
        "title": "How do I edit a service?",
        "steps": [
          "From the sidebar, open \"Services\".",
          "Press \"Edit\" next to the service, or \"+ New Service\" to add one.",
          "Update the name, description, and icon in Arabic and English.",
          "Press \"Save Service\"."
        ]
      },
      "projects": {
        "title": "How do I add a project?",
        "steps": [
          "From the sidebar, open \"Projects\".",
          "Press \"+ New Project\".",
          "Fill in the title, description, and category in Arabic and English.",
          "Upload the cover image and gallery photos, then press \"Create Project\"."
        ]
      },
      "hero": {
        "title": "How do I change the homepage?",
        "steps": [
          "From the sidebar, open \"Homepage\".",
          "Edit the headline, description, and button text in Arabic and English.",
          "Choose a background image or video from the Media Library.",
          "Press \"Save Hero Section\"."
        ]
      },
      "media": {
        "title": "How do I upload a photo?",
        "steps": [
          "From the sidebar, open \"Photos & Files\".",
          "Press \"Upload Files\" and choose the photo from your device.",
          "Once uploaded, press \"Copy URL\" on that photo.",
          "Paste that link anywhere a form asks for an image (Services, Projects, Homepage, etc.)."
        ]
      },
      "testimonials": {
        "title": "How do I add a client testimonial?",
        "steps": [
          "From the sidebar, open \"Client Testimonials\".",
          "Press \"+ New Testimonial\".",
          "Fill in the client's name, company, and their words in Arabic and English.",
          "Press \"Create Testimonial\"."
        ]
      },
      "messages": {
        "title": "How do I handle messages?",
        "steps": [
          "From the sidebar, open \"Messages\".",
          "Every inquiry sent from the website's contact form appears here.",
          "Press \"Open\" to read the full message and reply by email.",
          "Change its status to \"Replied\" once you've handled it."
        ]
      },
      "clients": {
        "title": "How do I add a client?",
        "steps": [
          "From the sidebar, open \"Clients\".",
          "Press \"+ New Client\".",
          "Fill in the company name, contact person, and email.",
          "Press \"Save\" — you can now link projects and contracts to this client."
        ]
      },
      "contracts": {
        "title": "How do I create a contract?",
        "steps": [
          "From the sidebar, open \"Contracts\".",
          "Press \"+ New Contract\", then pick the client (and the project, if related).",
          "Fill in the scope of work and the total price.",
          "Press \"Create Contract\" — you can then print it or sign it from the contract page."
        ]
      }
    }
  },
