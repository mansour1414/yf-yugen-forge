{
  "name": "yf-digital-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -p tsconfig.json && vite build",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "dev:server": "tsx watch src/server/server.ts",
    "build:server": "prisma generate && tsc --noEmit -p tsconfig.server.json && npx esbuild src/server/server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server/server.cjs --external:@prisma/client --external:@prisma/adapter-pg --external:pg --external:bcrypt --external:sharp --external:pino --external:express --external:helmet --external:cors --external:cookie-parser --external:multer --external:pino-http --external:jsonwebtoken --external:zod --external:dotenv --external:express-rate-limit --external:compression --external:ffprobe-static",
    "start": "node dist/server/server.cjs",
    "postinstall": "prisma generate",
    "start:pm2": "pm2 start ecosystem.config.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy": "npx prisma migrate deploy && npm run build",
    "seed": "tsx prisma/seed.ts",
    "verify": "tsx scripts/verify-backend.ts",
    "reset:media": "tsx scripts/reset-media.ts",
    "test:password": "tsx scripts/test-password.ts",
    "test:jwt": "tsx scripts/test-jwt.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:refresh": "tsx scripts/test-refresh-token.ts",
    "test:schemas": "tsx scripts/test-schemas.ts",
    "test:security": "tsx scripts/test-security.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.2.0",
    "@types/pino": "^7.0.4",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "ffprobe-static": "^3.1.0",
    "google-auth-library": "^11.0.2",
    "gsap": "^3.12.5",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.5",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
