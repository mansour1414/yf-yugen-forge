DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_HASH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES=30d
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5000
NODE_ENV=development

# Required in production builds (e.g. the Vercel frontend). The base URL of
# the deployed backend API, e.g. https://your-app.onrender.com — no trailing
# slash. If left blank in a production build, the app fails fast on load
# instead of silently pointing requests at localhost. Safe to leave blank for
# local development; it defaults to http://localhost:5000.
VITE_API_URL=

# Optional: force the canonical/Open Graph site origin used by <SEO> (e.g. if the site
# is deployed behind a proxy/CDN and the browser's own origin isn't the public domain).
# If left blank, the browser's actual origin is used automatically — usually correct.
VITE_SITE_URL=

# Google Sign-In (Google Identity Services). Both must be the SAME OAuth 2.0
# Web Client ID from Google Cloud Console — see docs/google-oauth-setup.md.
# Leave blank to keep Google Sign-In disabled; email/password login is unaffected.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional: outbound email for the contact form's "Email" option.
# If left blank, the email service skips sending and only logs a warning —
# the contact form still works and messages are still saved either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Used by docker-compose.yml only (Postgres container + DATABASE_URL construction)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
